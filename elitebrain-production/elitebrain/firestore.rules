rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email.toLowerCase() == 'unfazed.adibiz@gmail.com';
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    // Allows user profile read and write for cloud sync across all auth modes
    match /users/{userId} {
      allow read, create, update: if true;
    }

    // --- Payment Requests Collection ---
    // Allows creating and reviewing payment verification requests
    match /payment_requests/{requestId} {
      allow read, create, update: if true;
    }

    // --- Admin Settings Collection ---
    // Allows reading and updating app configurations (e.g., merchant UPI ID)
    match /admin_settings/{settingId} {
      allow read, create, update: if true;
    }

    // --- System Config Collection ---
    // Allows reading and updating system configurations (e.g., community Telegram link, merchant payment)
    match /system_config/{configId} {
      allow read, create, update: if true;
    }
  }
}


