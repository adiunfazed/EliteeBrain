rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'unfazed.adibiz@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function profileMap() {
      return request.resource.data.get('profileData', {});
    }

    // Counters that live on the user's own profile and feed the leaderboard.
    //
    // The server recomputes task, habit, routine, focus and sleep XP from the
    // activity records themselves, so those cannot be forged. Game XP is a
    // plain counter on the profile, and the owner can write their own
    // profile — so the obvious attack is to set it to a huge number.
    //
    // The enforcing control is server-side: serverLeaderboard clamps every
    // profile-sourced figure before it counts toward a rank, including the
    // per-module totals that rules cannot iterate over. This is the outer
    // fence, rejecting a value that is not even the right shape.
    //
    // Some accounts store profileData as a JSON string rather than a map.
    // Those are skipped rather than denied: blocking them would break profile
    // writes for existing users, and the server reads no XP out of a string
    // anyway, so they contribute nothing to a rank.
    function profileCountersSane() {
      return !(profileMap() is map)
             || (profileMap().get('gamesXp', 0) is number
                 && profileMap().get('gamesXp', 0) >= 0
                 && profileMap().get('gamesXp', 0) <= 1000000);
    }

    // Deny anything not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users ---
    // A user may read and write ONLY their own document, and may never change
    // their own Pro status. Only the admin can grant Pro.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.get('lifetimePro', false) == false
                    && profileCountersSane();

      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && profileCountersSane()
                        // A user may never alter their own entitlement:
                        // not the Pro flag, not lifetime, and not the trial
                        // clock (which would otherwise allow endless trials).
                        && request.resource.data.get('isProUser', false)
                           == resource.data.get('isProUser', false)
                        && request.resource.data.get('lifetimePro', false)
                           == resource.data.get('lifetimePro', false)
                        && request.resource.data.get('trialStartedAt', '')
                           == resource.data.get('trialStartedAt', '')
                        && request.resource.data.get('proExpiresAt', '')
                           == resource.data.get('proExpiresAt', ''));

      allow delete: if isAdmin();
    }

    // --- Tasks (users/{uid}/tasks/{taskId}) ---
    // Strictly private: a user reads and writes only their own tasks.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Focus sessions (users/{uid}/focusSessions/{id}) ---
    match /users/{userId}/focusSessions/{sessionId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Goals, habits and habit logs. Strictly private, same as tasks. ---
    match /users/{userId}/goals/{goalId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/habits/{habitId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/habitLogs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Body training and alarms. Private: when someone wakes up and what
    //     they can physically do are not for other accounts to read. ---
    //
    // A workout document holds the sets completed, the reps achieved in each
    // of them, and the personal records derived from those. It is the user's
    // own training record and nothing on the leaderboard is computed from it,
    // so the owner writes it freely — but nobody else can read a line of it.
    match /users/{userId}/workouts/{workoutId} {
      allow read, write: if isOwner(userId);
    }

    // --- Personal records (users/{uid}/records/{exerciseId}) ---
    //
    // One small document per exercise, holding the best single set. Written
    // the instant a record is set, separately from the workout, so a personal
    // best cannot be lost to a failed workout write.
    //
    // Nothing on the leaderboard is computed from these, so there is no
    // incentive to forge one and no ceiling to enforce — but the shape is
    // checked so a malformed write cannot break the reader, and the document
    // id must match the exercise it claims.
    match /users/{userId}/records/{exerciseId} {
      allow read: if isOwner(userId);

      allow write: if isOwner(userId)
                   && request.resource.data.get('exerciseId', '') == exerciseId
                   && request.resource.data.get('value', 0) is number
                   && request.resource.data.get('value', 0) > 0
                   && request.resource.data.get('value', 0) <= 100000;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/alarms/{alarmId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/alarmLogs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Delivery records, written only by the server through the Admin SDK,
    // which bypasses these rules. Readable so the client can tell an alarm
    // already fired; never writable, since deleting one would let the same
    // alarm ring repeatedly.
    match /users/{userId}/alarmSends/{sendId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // --- Routine and sleep. Strictly private, same as everything else. ---
    match /users/{userId}/routineBlocks/{blockId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/routineLogs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/sleepLogs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/goalSnapshots/{snapId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- AI Coach conversation. Private to the owner; synced so the same
    //     account shows the same thread on every device. ---
    match /users/{userId}/coachChat/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Push subscriptions. A push endpoint is a capability: anyone holding
    //     it can notify that device. Written only by the server, and readable
    //     by nobody from a client. ---
    match /users/{userId}/pushSubscriptions/{subId} {
      allow read, write: if false;
    }

    // --- Leaderboard ---
    // Readable by any signed-in user because it contains ONLY public fields
    // (display name, XP, level). Never readable anonymously, and never
    // writable from a client: entries are written exclusively by the server
    // through the Admin SDK after recomputing XP from stored activity.
    match /leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Payment requests ---
    // A user can file their own request and watch its status. Only the admin
    // can approve, edit, or delete one.
    match /payment_requests/{requestId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      allow create: if isSignedIn()
                    && request.resource.data.get('userId', '') == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // --- Admin settings ---
    match /admin_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Public system config (e.g. community link) ---
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
